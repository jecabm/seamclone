{
  "expo": {
    "name": "SeamClone",
    "slug": "seamclone-jb-private",
    "version": "1.0.0-ALPHA",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seamclonejb",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jessicabossio.seamclone",
      "infoPlist": {
        "NSCameraUsageDescription": "SeamClone uses the camera to scan garments and a standard card for precise pattern scaling.",
        "NSMotionUsageDescription": "SeamClone uses motion sensors to ensure your phone is level for accurate pattern capture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0066CC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jessicabossio.seamclone"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6f7f6525-f48d-407c-8f05-6a796782678f"
      }
    }
  }
}
